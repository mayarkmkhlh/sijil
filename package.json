{
  "name": "mursal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm --filter @mursal/web dev",
    "dev:api": "pnpm --filter @mursal/api dev",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
