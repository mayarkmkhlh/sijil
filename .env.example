# Copy to .env and fill in the key. .env is gitignored.

# Meta Model API. Standard mode model muse-spark-1.3. Never commit the key.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3

# Local API port.
PORT=3001

# Postgres. Laptop migration uses the Render External URL. The deployed API uses the Internal URL.
DATABASE_URL=

# true only for the laptop migration against the External URL. Leave unset on Render.
DATABASE_SSL=

# WhatsApp Cloud API. The token and app secret stay in this file and in the Render dashboard.
# Never commit them. Phone number ID is the test number's ID, not your personal number.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SELLER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
