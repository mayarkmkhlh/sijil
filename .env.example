# Copy to .env and fill in the key. .env is gitignored.

# Meta Model API. Standard mode model muse-spark-1.3. Never commit the key.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3

# Local API port.
PORT=3001

# Postgres. Use the Render external URL once, from your laptop, to migrate.
DATABASE_URL=
